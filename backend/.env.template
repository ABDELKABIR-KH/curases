STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com

# Production: public URL of the Medusa API (admin static UI calls this).
# Local: http://localhost:9000
MEDUSA_BACKEND_URL=http://localhost:9000

# shared | server | worker — use server + separate worker service in production (see Medusa deploy guide).
MEDUSA_WORKER_MODE=shared

# true on worker-only deployments; false on the server that serves admin/API.
DISABLE_MEDUSA_ADMIN=false

REDIS_URL=redis://localhost:6379
CACHE_REDIS_URL=redis://localhost:6379
EVENTS_REDIS_URL=redis://localhost:6379
WORKFLOW_REDIS_URL=redis://localhost:6379
LOCKING_REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend
